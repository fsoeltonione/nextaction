{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nextaction",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "env": {
    "staging": {
      "name": "nextaction-staging",
      "workers_dev": true,
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "invocation_logs": true,
          "head_sampling_rate": 1
        }
      },
      "vars": {
        "APP_ENV": "staging",
        "NEXT_PUBLIC_SUPABASE_URL": "https://njjybpswxalxjhqjlvqa.supabase.co",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_XhqGHkpYkUX278dF86SYJQ_OY2S9ID_"
      }
    },
    "production": {
      "name": "nextaction",
      "workers_dev": true,
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "invocation_logs": true,
          "head_sampling_rate": 1
        }
      },
      "vars": {
        "APP_ENV": "production",
        "NEXT_PUBLIC_SUPABASE_URL": "https://khoygjyikxkdwonygzyh.supabase.co",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_n4OUdr5cMIGT43I0ShLEOg_l3uayuFT"
      }
    }
  }
}
